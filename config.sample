# Sample configuration file for go-polipo.  -*-sh-*-
#
# All variables have reasonable defaults, so a configuration file is
# optional.  To use one, copy this to ~/.polipo or /etc/polipo/config and
# uncomment the lines you want, or pass a path with "polipo -c <file>".
#
# Values may be quoted with " or '.  A '#' starts a comment.  Trailing
# "var=val" arguments on the command line override the file, e.g.
#   polipo -c ~/.polipo proxyPort=8080
#
# The full list of effective values is printed by "polipo -v".


### Listening socket

# proxyAddress = "127.0.0.1"   # loopback only; do NOT expose without an ACL
# proxyPort = 8123

# Clients allowed to use the proxy: bare IPs, CIDR ranges, or "all".
# The check uses the real TCP peer address; forwarding headers are ignored.
# allowedClients = 127.0.0.1, ::1
# allowedClients = 127.0.0.1, 192.168.0.0/24


### On-disk cache

# diskCacheRoot = "/var/cache/polipo/"

# Disable the on-disk cache entirely (memory-only proxying).  Setting
# diskCacheRoot = "" has the same effect.
# noDiskCache = false

# Keep responses carrying a Set-Cookie header out of the disk cache.  On by
# default: a cached Set-Cookie is replayed to every later requester of the same
# URL.  Set false for Polipo's historical behaviour.
# dontCacheCookies = true

# "polipo -x" removes entries not accessed within this period (plus corrupt
# and HTTP-stale entries).  Units: s, m, h, d.  0 disables the age cap.
# diskCacheUnlinkTime = 32d

# Responses to requests that carry an Authorization header are never written to
# the disk cache unless the response is explicitly shareable
# (Cache-Control: public, s-maxage, or must-revalidate), per RFC 9111.


### Access filters (see forbidden.sample for the file format)

# forbiddenFile = "/etc/polipo/forbidden"     # URLs to reject with 403
# uncachableFile = "/etc/polipo/uncachable"   # URLs to forward but never cache


### Outgoing connections

# Ports the proxy may open for plain-HTTP (non-CONNECT) forwarding.  Syntax:
# single ports and "lo-hi" ranges, comma-separated.  A request to a port not
# in this list is rejected with 403.  The default is Polipo's: it allows
# 80-100 and every unprivileged port, so the proxy cannot be used to reach
# SMTP (25), POP (110), IMAP (143), NNTP (119) and similar services.
# allowedPorts = 80-100, 1024-65535


### Parent proxies

# parentProxy = "squid.example.org:3128"      # upstream HTTP proxy
# socksParentProxy = "localhost:9050"         # upstream SOCKS5 proxy
# socksProxyType = socks5


### HTTPS tunnelling (CONNECT)

# Ports the proxy may open for CONNECT tunnels.  Checked instead of, not in
# addition to, allowedPorts.  Same "lo-hi" range syntax.
# tunnelAllowedPorts = 443, 563


### Misc

# maxConcurrentRequests = 100   # 0 = unlimited
# disableLocalInterface = false # disables /polipo/ and /polipo/config
# logLevel = 0x07

# Redirect logs to a file instead of standard error.  Required for silent
# background use on Windows (a "-H windowsgui" build has no console).
# logFile = "C:/Users/you/AppData/Local/go-polipo/polipo.log"
