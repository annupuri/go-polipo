# build output: `make build`/`make build-windows` write to bin/; a bare
# `go build` (no -o) still produces one named after the module directory
# (go-polipo) at the repo root.
/bin/
go-polipo
coverage.out

# Inno Setup output (built locally, see windows/polipo.iss).
windows/dist/

# Local scratch space for ad-hoc notes/files while working in this repo;
# not part of the project, never committed.
tmp

# Per-user editor settings, e.g. the .vscode/settings.json that VS Code
# writes when an extension's setting is changed for this folder only;
# not part of the project.
.vscode/
